{
  "name": "@ggm/client",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ggm/types build && next dev",
    "build": "pnpm --filter @ggm/types build && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "pnpm --filter @ggm/types build && next build && playwright test",
    "test:styleguide": "playwright test --config playwright.styleguide.config.ts",
    "analyze": "next experimental-analyze --output"
  },
  "dependencies": {
    "@ggm/types": "workspace:*",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
