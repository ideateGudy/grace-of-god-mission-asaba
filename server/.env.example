# Database connections (Neon Postgres)
DATABASE_URL=
DIRECT_URL=
PRISMA_HIDE_UPDATE_MESSAGE=true

# Authentication & Security (Short-lived access token + long-lived refresh token)
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=https://your-vercel-app.vercel.app
NODE_ENV=production
PORT=5000

# Super Admin initial seed credentials
SUPER_ADMIN_SEED_EMAIL=
SUPER_ADMIN_SEED_PASSWORD=

# Next.js ISR on-demand revalidation
REVALIDATE_SECRET=
WEB_REVALIDATE_URL=https://your-vercel-app.vercel.app/api/revalidate
IMAGE_ALLOWED_HOSTS=images.unsplash.com,res.cloudinary.com

# Cloudinary signed image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack Online Giving (Phase 2)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Neon database branching for E2E tests (neon-testing)
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_PARENT_BRANCH_ID=
NEON_DATABASE_NAME=
