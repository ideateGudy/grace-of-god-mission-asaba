{
    "name": "@ggm/server",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "build": "prisma generate --config prisma.config.ts && nest build",
        "typecheck": "tsc --noEmit",
        "deploy": "nest deploy",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main.js",
        "lint": "oxlint --type-aware src/ test/",
        "test": "pnpm --filter @ggm/types build && vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:debug": "vitest --inspect-brk --no-file-parallelism",
        "test:e2e": "pnpm --filter @ggm/types build && vitest run --config ./vitest.config.e2e.ts",
        "seed": "tsx prisma/seed.ts",
        "migrate:dev": "prisma migrate dev --config prisma.config.ts",
        "migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
        "generate": "prisma generate --config prisma.config.ts",
        "postinstall": "prisma generate --config prisma.config.ts || exit 0",
        "cli:reset-super-admin": "tsx src/cli/reset-super-admin.ts",
        "cli:reset-2fa": "tsx src/cli/reset-2fa.ts"
    },
    "dependencies": {
        "@ggm/types": "workspace:*",
        "@nest-lab/throttler-storage-redis": "^1.2.0",
        "@nestjs/common": "^12.0.1",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^12.0.1",
        "@nestjs/jwt": "^12.0.2",
        "@nestjs/observe": "^0.3.0",
        "@nestjs/platform-express": "^12.0.1",
        "@nestjs/swagger": "^12.0.0",
        "@nestjs/throttler": "^6.7.1",
        "@prisma/adapter-pg": "7.10.0",
        "@prisma/client": "7.10.0",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "helmet": "^8.3.0",
        "ioredis": "^6.0.0",
        "pg": "^8.16.3",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.0",
        "@nestjs/mau": "^0.2.6",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/testing": "^12.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.0",
        "@types/node": "^24.0.0",
        "@types/supertest": "^7.0.0",
        "@vitest/coverage-v8": "^4.1.2",
        "neon-testing": "^3.0.2",
        "oxlint": "^1.58.0",
        "oxlint-tsgolint": "^7.0.2001",
        "prettier": "^3.4.2",
        "prisma": "7.10.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "tsx": "^4.20.6",
        "typescript": "^6.0.2",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^4.1.2"
    }
}
